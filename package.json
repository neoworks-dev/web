{
  "name": "neoworks.dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:e2e": "playwright test",
    "test:e2e:stub": "playwright test -c playwright.stub.config.ts",
    "stub:developer-api": "bun tests/support/developerApiStub.ts",
    "dev:stub": "API_URL=http://127.0.0.1:4310 OAUTH_URL=http://127.0.0.1:4310 vite dev --host 127.0.0.1 --port 4311"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@neoworks-dev/sdk": "workspace:*",
    "@neoworks-dev/ui": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "daisyui": "^5.5.23",
    "mdsvex": "^0.12.7",
    "openschema": "workspace:*",
    "phosphor-svelte": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-slug": "^6.0.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "web-tree-sitter": "^0.26.9"
  }
}
